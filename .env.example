GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Search providers (set one or both; Serper is preferred in auto mode)
SERPER_API_KEY=
TAVILY_API_KEY=
SEARCH_PROVIDER=auto
SEARCH_FALLBACK_ON_EMPTY=true
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_ATTEMPTS=2
SEARCH_CONCURRENCY=3

# Optional Notion logging
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_MCP_URL=

# Optional Langfuse tracing (US cloud default; set LANGFUSE_HOST for other regions)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Paths
OUTPUTS_DIR=outputs
RESUMES_DIR=resumes
USER_PROFILE_PATH=context/user_profile.yaml
LIBREOFFICE_PATH=

# Optional cover-letter contact header (blank values are omitted)
COVER_LETTER_EMAIL=
COVER_LETTER_PHONE=
COVER_LETTER_LOCATION=
COVER_LETTER_LINKEDIN_URL=
COVER_LETTER_PORTFOLIO_URL=
